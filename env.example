# ═══════════════════════════════════════════════════════════════════════
#  Hybrid AI Multi-Agent Swing Trading System — Environment Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env or gcp_key.json to version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Alpaca Broker ──────────────────────────────────────────────────────
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Switch to live only after successful paper trading validation:
# ALPACA_BASE_URL=https://api.alpaca.markets

# ── Risk Management ────────────────────────────────────────────────────
TRAILING_STOP_PCT=3.0          # ATR-unavailable fallback trailing %
MAX_POZISYON_PCT=0.15          # Max single position as fraction of equity

# ── V5 Pyramiding ──────────────────────────────────────────────────────
PYRAMIDING_AKTIF=true
PYRAMIDING_ATR_KATSAYI=1.5     # Add at entry + N×ATR threshold (backtest-tuned)

# ── AI APIs (all optional — system runs in mock mode without them) ─────
GEMINI_API_KEY=AIzaSy...       # sentiment_agent.py — enables Gemini Flash
OPENAI_API_KEY=sk-...          # analyst_agent.py   — enables GPT-4o-mini (CrewAI)
ANTHROPIC_API_KEY=sk-ant-...   # state_manager.py   — enables Claude final veto

# ── Notifications ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAF_xxxxxxxx
TELEGRAM_CHAT_ID=123456789     # Personal: positive ID | Group/Channel: negative ID

# ── Google Sheets Dashboard ────────────────────────────────────────────
SHEET_ID=your_google_sheet_id_here
GCP_KEY_PATH=gcp_key.json      # Service account JSON path — add to .gitignore!
